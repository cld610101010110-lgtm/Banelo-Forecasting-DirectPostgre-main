  {
   "cell_type": "markdown",
   "metadata": {
    "id": "forecast_section"
   },
   "source": [
    "## 7. Forecast Generation"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "id": "forecast_cell"
   },
   "outputs": [],
   "source": [
    "print(\"\\n\" + \"=\"*70)\n",
    "print(\"GENERATING FORECASTS\")\n",
    "print(\"=\"*70)\n",
    "\n",
    "# Create forecast for next 30 days\n",
    "last_date = df_features['date'].max()\n",
    "forecast_dates = pd.date_range(start=last_date + timedelta(days=1), periods=30, freq='D')\n",
    "\n",
    "print(f\"\\n📅 Forecast Period: {forecast_dates[0].date()} to {forecast_dates[-1].date()}\")\n",
    "print(f\"🎯 Number of days: {len(forecast_dates)}\")\n",
    "\n",
    "# Use last day's features as template for forecasting\n",
    "last_row = df_features.iloc[-1][feature_columns].values.reshape(1, -1)\n",
    "\n",
    "# Generate forecast using Gradient Boosting\n",
    "daily_forecasts = []\n",
    "for i, forecast_date in enumerate(forecast_dates):\n",
    "    # Create feature vector\n",
    "    forecast_features = last_row.copy()\n",
    "    \n",
    "    # Update time-based features\n",
    "    forecast_features[0][0] = forecast_date.dayofweek  # day_of_week\n",
    "    forecast_features[0][1] = forecast_date.day  # day_of_month\n",
    "    forecast_features[0][2] = forecast_date.month  # month\n",
    "    forecast_features[0][3] = forecast_date.year  # year\n",
    "    forecast_features[0][4] = forecast_date.isocalendar()[1]  # week_of_year\n",
    "    forecast_features[0][5] = 1 if forecast_date.dayofweek in [5, 6] else 0  # is_weekend\n",
    "    \n",
    "    # Predict\n",
    "    pred = gb_model.predict(forecast_features)[0]\n",
    "    daily_forecasts.append({\n",
    "        'date': forecast_date.date(),\n",
    "        'forecast_quantity': max(0, pred),  # Ensure non-negative\n",
    "        'forecast_revenue': max(0, pred) * 50  # Assuming ₱50 average price\n",
    "    })\n",
    "\n",
    "forecast_df = pd.DataFrame(daily_forecasts)\n",
    "\n",
    "print(f\"\\n📊 Daily Forecast (First 10 days):\")\n",
    "print(forecast_df.head(10).to_string(index=False))\n",
    "\n",
    "# Weekly forecast\n",
    "forecast_df['week'] = pd.to_datetime(forecast_df['date']).dt.isocalendar().week\n",
    "weekly_forecast = forecast_df.groupby('week').agg({\n",
    "    'forecast_quantity': 'sum',\n",
    "    'forecast_revenue': 'sum'\n",
    "}).reset_index()\n",
    "\n",
    "print(f\"\\n📅 Weekly Forecast:\")\n",
