{% extends 'dashboard/base.html' %}

{% block title %}Sales Forecasting - Banelo Coffee{% endblock %}

{% block extra_css %}
<style>
    .forecast-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 20px;
    }

    .page-header {
        text-align: center;
        margin-bottom: 40px;
    }

    .page-header h1 {
        font-size: 32px;
        font-weight: 700;
        color: var(--text-primary);
        margin-bottom: 10px;
    }

    .page-header p {
        color: var(--text-secondary);
        font-size: 16px;
    }

    /* Status Cards */
    .status-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .status-card {
        background: var(--card-bg);
        padding: 25px;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        border: 1px solid var(--border-color);
    }

    .status-card-header {
        display: flex;
        align-items: center;
        gap: 15px;
        margin-bottom: 15px;
    }

    .status-icon {
        width: 50px;
        height: 50px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
    }

    .status-icon.ready {
        background: linear-gradient(135deg, #4CAF50 0%, #66BB6A 100%);
        color: white;
    }

    .status-icon.warning {
        background: linear-gradient(135deg, #FF9800 0%, #FFB74D 100%);
        color: white;
    }

    .status-icon.error {
        background: linear-gradient(135deg, #F44336 0%, #EF5350 100%);
        color: white;
    }

    .status-card h3 {
        font-size: 16px;
        font-weight: 600;
        color: var(--text-primary);
        margin: 0;
    }

    .status-card-value {
        font-size: 28px;
        font-weight: 700;
        color: var(--text-primary);
        margin-bottom: 5px;
    }

    .status-card-label {
        font-size: 14px;
        color: var(--text-secondary);
    }

    /* Forecast Controls */
    .forecast-controls {
        background: var(--card-bg);
        padding: 25px;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        border: 1px solid var(--border-color);
        margin-bottom: 30px;
    }

    .forecast-controls h3 {
        font-size: 20px;
        font-weight: 600;
        margin-bottom: 20px;
        color: var(--text-primary);
    }

    .controls-row {
        display: flex;
        gap: 15px;
        align-items: flex-end;
        flex-wrap: wrap;
    }

    .control-group {
        flex: 1;
        min-width: 200px;
    }

    .control-group label {
        display: block;
        font-size: 14px;
        font-weight: 500;
        color: var(--text-primary);
        margin-bottom: 8px;
    }

    .control-group select {
        width: 100%;
        padding: 12px;
        border: 1px solid var(--border-color);
        border-radius: 8px;
        background: var(--bg-primary);
        color: var(--text-primary);
        font-size: 14px;
        cursor: pointer;
    }

    .btn-forecast {
        padding: 12px 30px;
        background: linear-gradient(135deg, #3E2723 0%, #5D4037 100%);
        color: white;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s;
    }

    .btn-forecast:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(62, 39, 35, 0.4);
    }

    .btn-forecast:disabled {
        background: #ccc;
        cursor: not-allowed;
        transform: none;
    }

    /* Chart Container */
    .chart-container {
        background: var(--card-bg);
        padding: 25px;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        border: 1px solid var(--border-color);
        margin-bottom: 30px;
    }

    .chart-container h3 {
        font-size: 20px;
        font-weight: 600;
        margin-bottom: 20px;
        color: var(--text-primary);
    }

    #forecastChart {
        max-height: 400px;
    }

    /* Forecast Table */
    .forecast-table-container {
        background: var(--card-bg);
        padding: 25px;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        border: 1px solid var(--border-color);
    }

    .forecast-table-container h3 {
        font-size: 20px;
        font-weight: 600;
        margin-bottom: 20px;
        color: var(--text-primary);
    }

    .forecast-table {
        width: 100%;
        border-collapse: collapse;
    }

    .forecast-table thead {
        background: var(--bg-primary);
    }

    .forecast-table th {
        padding: 12px;
        text-align: left;
        font-weight: 600;
        color: var(--text-primary);
        border-bottom: 2px solid var(--border-color);
    }

    .forecast-table td {
        padding: 12px;
        border-bottom: 1px solid var(--border-color);
        color: var(--text-primary);
    }

    .forecast-table tbody tr:hover {
        background: var(--bg-primary);
    }

    .weekend-row {
        background: rgba(255, 193, 7, 0.1);
    }

    .revenue-value {
        font-weight: 600;
        color: #4CAF50;
    }

    /* Loading Spinner */
    .loading-spinner {
        display: none;
        text-align: center;
        padding: 40px;
    }

    .spinner {
        border: 4px solid var(--border-color);
        border-top: 4px solid #3E2723;
        border-radius: 50%;
        width: 50px;
        height: 50px;
        animation: spin 1s linear infinite;
        margin: 0 auto 20px;
    }

    @keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }

    /* Error/Warning Messages */
    .alert {
        padding: 15px 20px;
        border-radius: 8px;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .alert-warning {
        background: #FFF3CD;
        border: 1px solid #FFE082;
        color: #856404;
    }

    .alert-error {
        background: #FFEBEE;
        border: 1px solid #FFCDD2;
        color: #C62828;
    }

    .alert-info {
        background: #E3F2FD;
        border: 1px solid #BBDEFB;
        color: #1565C0;
    }

    .alert i {
        font-size: 24px;
    }

    /* Responsive */
    @media (max-width: 768px) {
        .controls-row {
            flex-direction: column;
        }

        .control-group {
            width: 100%;
        }

        .status-cards {
            grid-template-columns: 1fr;
        }
    }
</style>
{% endblock %}

{% block content %}
<div class="forecast-container">
    <!-- Page Header -->
    <div class="page-header">
        <h1><i class="fas fa-chart-line"></i> Sales Forecasting</h1>
        <p>AI-powered sales predictions using XGBoost Machine Learning</p>
    </div>

    

        

    <!-- Forecast Controls -->
    <div class="forecast-controls">
        <h3><i class="fas fa-sliders-h"></i> Forecast Settings</h3>
        <div class="controls-row">
            <div class="control-group">
                <label for="forecastDays">Forecast Period</label>
                <select id="forecastDays">
                    <option value="7">7 Days (1 Week)</option>
                    <option value="14">14 Days (2 Weeks)</option>
                    <option value="21">21 Days (3 Weeks)</option>
                    <option value="30">30 Days (1 Month)</option>
                </select>
            </div>
            <button class="btn-forecast" onclick="generateForecast()" id="forecastBtn" {% if not model_ready %}disabled{% endif %}>
                <i class="fas fa-magic"></i> Generate Forecast
            </button>
        </div>
    </div>

    <!-- Loading Spinner -->
    <div class="loading-spinner" id="loadingSpinner">
        <div class="spinner"></div>
        <p>Generating predictions...</p>
    </div>

    <!-- Forecast Chart -->
    <div class="chart-container" id="chartContainer" style="display: none;">
        <h3><i class="fas fa-chart-area"></i> Revenue Forecast</h3>
        <canvas id="forecastChart"></canvas>
    </div>

    <!-- Forecast Table -->
    <div class="forecast-table-container" id="tableContainer" style="display: none;">
        <h3><i class="fas fa-table"></i> Detailed Predictions</h3>
        <table class="forecast-table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Day</th>
                    <th>Predicted Revenue</th>
                    <th>Lower Bound</th>
                    <th>Upper Bound</th>
                </tr>
            </thead>
            <tbody id="forecastTableBody">
                <!-- Forecast data will be inserted here -->
            </tbody>
            <tfoot>
                <tr style="background: var(--bg-primary); font-weight: 600;">
                    <td colspan="2">TOTAL</td>
                    <td class="revenue-value" id="totalForecast">-</td>
                    <td colspan="2">Average: <span id="avgForecast">-</span></td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

<!-- Chart.js Library -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

<script>
let forecastChart = null;

// Check model status on page load
document.addEventListener('DOMContentLoaded', function() {
    checkModelStatus();
});

async function checkModelStatus() {
    try {
        const response = await fetch('/dashboard/api/sales-forecast/status/');
        const data = await response.json();

        if (data.success && data.model_loaded) {
            document.getElementById('modelStatus').textContent = 'Ready';
            document.getElementById('modelType').textContent = data.model_type || 'XGBoost';
            document.getElementById('featuresCount').textContent = data.features_count || '-';
            document.getElementById('forecastBtn').disabled = false;
        } else {
            document.getElementById('modelStatus').textContent = 'Not Loaded';
            document.getElementById('forecastBtn').disabled = true;
        }
    } catch (error) {
        console.error('Error checking model status:', error);
    }
}

async function generateForecast() {
    const days = document.getElementById('forecastDays').value;
    const loadingSpinner = document.getElementById('loadingSpinner');
    const chartContainer = document.getElementById('chartContainer');
    const tableContainer = document.getElementById('tableContainer');

    // Show loading
    loadingSpinner.style.display = 'block';
    chartContainer.style.display = 'none';
    tableContainer.style.display = 'none';

    try {
        const response = await fetch(`/dashboard/api/sales-forecast/predict/?days=${days}`);
        const data = await response.json();

        if (!data.success) {
            alert('Error: ' + data.message);
            loadingSpinner.style.display = 'none';
            return;
        }

        // Hide loading, show results
        loadingSpinner.style.display = 'none';
        chartContainer.style.display = 'block';
        tableContainer.style.display = 'block';

        // Render chart
        renderChart(data.predictions);

        // Render table
        renderTable(data.predictions, data.summary);

    } catch (error) {
        console.error('Error generating forecast:', error);
        alert('Failed to generate forecast. Please check the console for details.');
        loadingSpinner.style.display = 'none';
    }
}

function renderChart(predictions) {
    const ctx = document.getElementById('forecastChart').getContext('2d');

    // Destroy previous chart if exists
    if (forecastChart) {
        forecastChart.destroy();
    }

    const labels = predictions.map(p => p.date);
    const predictedData = predictions.map(p => p.predicted_revenue);
    const lowerBound = predictions.map(p => p.lower_bound);
    const upperBound = predictions.map(p => p.upper_bound);

    forecastChart = new Chart(ctx, {
        type: 'line',
        data: {
            labels: labels,
            datasets: [
                {
                    label: 'Predicted Revenue',
                    data: predictedData,
                    borderColor: '#3E2723',
                    backgroundColor: 'rgba(62, 39, 35, 0.1)',
                    borderWidth: 3,
                    tension: 0.4,
                    fill: true,
                },
                {
                    label: 'Upper Bound',
                    data: upperBound,
                    borderColor: 'rgba(76, 175, 80, 0.5)',
                    borderWidth: 1,
                    borderDash: [5, 5],
                    tension: 0.4,
                    fill: false,
                },
                {
                    label: 'Lower Bound',
                    data: lowerBound,
                    borderColor: 'rgba(244, 67, 54, 0.5)',
                    borderWidth: 1,
                    borderDash: [5, 5],
                    tension: 0.4,
                    fill: false,
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: true,
            plugins: {
                legend: {
                    display: true,
                    position: 'top',
                },
                tooltip: {
                    callbacks: {
                        label: function(context) {
                            return context.dataset.label + ': ₱' + context.parsed.y.toFixed(2);
                        }
                    }
                }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    ticks: {
                        callback: function(value) {
                            return '₱' + value.toFixed(0);
                        }
                    }
                }
            }
        }
    });
}

function renderTable(predictions, summary) {
    const tbody = document.getElementById('forecastTableBody');
    tbody.innerHTML = '';

    predictions.forEach(pred => {
        const row = document.createElement('tr');
        if (pred.is_weekend) {
            row.classList.add('weekend-row');
        }

        row.innerHTML = `
            <td>${pred.date}</td>
            <td>${pred.day_name}</td>
            <td class="revenue-value">₱${pred.predicted_revenue.toFixed(2)}</td>
            <td>₱${pred.lower_bound.toFixed(2)}</td>
            <td>₱${pred.upper_bound.toFixed(2)}</td>
        `;

        tbody.appendChild(row);
    });

    // Update summary
    document.getElementById('totalForecast').textContent = '₱' + summary.total_forecast.toFixed(2);
    document.getElementById('avgForecast').textContent = '₱' + summary.average_daily.toFixed(2);
}
</script>
{% endblock %}
